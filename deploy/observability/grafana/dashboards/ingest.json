{
  "uid": "ingestao",
  "title": "Ingestão",
  "schemaVersion": 39,
  "timezone": "America/Sao_Paulo",
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Fila",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(diel_stream_backlog)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Pacotes por segundo",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(diel_ingest_packets_total[5m]))", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Lotes rejeitados",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(diel_ingest_failures_total[5m]))", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Erros da API",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rate(diel_http_errors_total[5m]))", "refId": "A" }]
    }
  ]
}
